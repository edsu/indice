/waczs.csv
/waczs.tsv
/sucho-wacz-urls*.txt
/scripts/browsertrix-wacz-urls.py

# Node / Playwright tooling (not used)
/node_modules
/package.json
/package-lock.json

# bv (beads viewer) local config and caches
.bv/

# Title-page image generated from images/*.svg at build time (see Makefile)
/images/*.pdf

.DS_Store

# Chrome for Testing + chromedriver (local browser testing, via @puppeteer/browsers)
/chrome/
/chromedriver/

# some environment vars for testing
env.sh

# Local docker-compose secrets (ADMIN_PASSWORD_HASH, INDICE_AUTH_PROXY_SECRET, …).
.env

# Landing site (Astro) build artifacts + deps.
/site/node_modules/
/site/dist/
/site/.astro/

# Archive-It import staging (created under the indice home; shows up here when
